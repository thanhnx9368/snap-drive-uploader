{
  "name": "snappy-drive",
  "version": "1.0.0",
  "description": "Auto upload images from a local folder to Google Drive — by Snappy Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build": "electron-builder"
  },
  "author": "Snappy Studio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.snappy.snappydrive",
    "productName": "Snappy Drive",
    "files": [
      "main.js",
      "uploader.js",
      "exif.js",
      "drive-target.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/icon.png",
      "assets/logo-mark.png"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "Snappy Drive",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
